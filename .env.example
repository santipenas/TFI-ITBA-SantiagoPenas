# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (EJEMPLO / TEMPLATE)
# TRABAJO FINAL INTEGRADOR - ITBA AI AGENT DEVELOPER
# ==============================================================================
# Copia este archivo como .env y completa tus credenciales personales.
# NUNCA comitees tu archivo .env real con claves secretas al repositorio.

# ------------------------------------------------------------------------------
# 1. MODELOS DE LENGUAJE (LLMs) Y FALLBACK
# ------------------------------------------------------------------------------
# Proveedor primario y secundario ("openai" o "gemini")
PRIMARY_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=gemini

# Modelos recomendados
OPENAI_MODEL_NAME=gpt-4o
GEMINI_MODEL_NAME=gemini-2.5-flash

# Claves de API para LLMs
OPENAI_API_KEY=tu_clave_de_openai_aqui
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GOOGLE_API_KEY=tu_clave_de_gemini_aqui

# ------------------------------------------------------------------------------
# 2. BROKER Y EJECUCIÓN: ALPACA PAPER TRADING (SANDBOX)
# ------------------------------------------------------------------------------
# NOTA: Usar EXCLUSIVAMENTE credenciales de Paper Trading (Sandbox).
ALPACA_API_KEY=tu_alpaca_paper_api_key
ALPACA_SECRET_KEY=tu_alpaca_paper_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ------------------------------------------------------------------------------
# 3. DATOS FUNDAMENTALES Y NOTICIAS
# ------------------------------------------------------------------------------
# Financial Modeling Prep (FMP) - Ratios financieros y fundamentales
FMP_API_KEY=tu_fmp_api_key

# Tavily AI Search - Noticias financieras y catalizadores de mercado
TAVILY_API_KEY=tu_tavily_api_key
# Alias soportado si se ingresa como TAVILI_API_KEY
TAVILI_API_KEY=tu_tavily_api_key

# FRED (Federal Reserve Economic Data) - Tasas y macroeconomía (Opcional)
FRED_API_KEY=tu_fred_api_key

# Finnhub Stock API - Calendario de earnings y sentimiento (Opcional)
FINNHUB_API_KEY=tu_finnhub_api_key

# Massive / Polygon.io API Key (Backup opcional)
MASSIVE_API_KEY=tu_massive_polygon_api_key

# Alpha Vantage (Backup opcional)
ALPHA_VANTAGE_API_KEY=tu_alpha_vantage_api_key

# ------------------------------------------------------------------------------
# 4. OBSERVABILIDAD Y TRAZABILIDAD (LANGSMITH)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=tu_langsmith_api_key
LANGCHAIN_PROJECT=itba-tfi-financial-agent

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN DEL SISTEMA Y BASE DE DATOS LOCAL
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CHECKPOINTS_DB_PATH=data/checkpoints.db
USER_PROFILE_DB_PATH=data/user_profile.db
